# Template config. Copy this file to `.env` and fill in the following for your local environment:
#   1) MySQL account and password in DATABASE_URL
#   2) ELASTICSEARCH_USERNAME / ELASTICSEARCH_PASSWORD
#   3) LLM_API_KEY (DeepSeek key; if left empty, Q&A uses the built-in mock answers)
# Do NOT put real secrets in this file — it is meant to be committed. Keep real values only in `.env`.

# ===== Application Basics =====
APP_NAME=Enterprise RAG Knowledge Base System
APP_SECRET_KEY=change-me-to-a-random-long-string
ACCESS_TOKEN_EXPIRE_MINUTES=120000
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== MySQL (please fill in your account and password) =====
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/rag_kb?charset=utf8mb4

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Elasticsearch =====
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ES_INDEX_PREFIX=rag_kb
ES_VERIFY_CERTS=false

# ===== LLM (DeepSeek) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_ENABLED=true

# ===== Vector Embedding =====
EMBEDDING_DIM=256

# ===== Files and Tasks =====
UPLOAD_DIR=./data/uploads
TASK_MODE=thread
